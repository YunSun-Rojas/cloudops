# Copia este archivo a ".env" y coloca las credenciales reales de tu proyecto Supabase.
# Panel de Supabase -> Project Settings -> API -> Project URL / anon public key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Clave de Gemini solo para el servidor; nunca usar el prefijo VITE_.
GEMINI_API_KEY=tu_clave_de_api_de_gemini_aqui
# Claves de proveedores de IA solo para el servidor; nunca usar el prefijo VITE_.
MISTRAL_API_KEY=mstrl_aqui_va_tu_clave_de_api_de_mistral
GROQ_API_KEY=gsk_aqui_va_tu_clave_de_api_de_groq
OPENROUTER_API_KEY=sk-or-aqui_va_tu_clave_de_api_de_openrouter